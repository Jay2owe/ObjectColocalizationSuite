license: BSD-3-Clause
version: "0.1.1"
date-released: "2026-09-30"
keywords:
  - imagej
  - fiji
  - image-analysis
  - microscopy
  - colocalization
  - object-based-colocalization
  - permutation-test
  - method-comparison
  - 3d
